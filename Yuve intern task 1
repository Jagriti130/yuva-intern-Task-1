"""
Acquire, explore, clean, and preprocess the UCI Air Quality dataset.

Install dependencies with:
    python -m pip install pandas numpy matplotlib

Outputs:
    AirQualityUCI_clean.csv
    AirQuality_preprocessing_report.txt
    missingness_map.png
    before_after.png
"""
from __future__ import annotations

import io
import zipfile

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import requests

URL = "https://archive.ics.uci.edu/static/public/360/air+quality.zip"
RAW = "AirQualityUCI.csv"
CLEAN = "AirQualityUCI_clean.csv"


# ---------------------------------------------------------------
# 1. DATA ACQUISITION
# ---------------------------------------------------------------
def download_dataset(url: str = URL, out: str = RAW) -> str:
    """Download the zip from UCI and extract the CSV."""
    response = requests.get(url, timeout=60)
    response.raise_for_status()
    with zipfile.ZipFile(io.BytesIO(response.content)) as zf:
        csv_name = next(
            n for n in zf.namelist()
            if n.endswith(".csv") and "__MACOSX" not in n
        )
        with zf.open(csv_name) as src, open(out, "wb") as dst:
            dst.write(src.read())
    print(f"Saved {csv_name} -> {out}")
    return out


# ---------------------------------------------------------------
# 2. INITIAL EXPLORATION
# ---------------------------------------------------------------
def load_raw(path: str = RAW) -> pd.DataFrame:
    # The file uses ';' as separator and ',' as decimal mark (European format)
    df = pd.read_csv(path, sep=";", decimal=",")
    # Drop empty trailing columns ('Unnamed: 15', 'Unnamed: 16')
    df = df.loc[:, ~df.columns.str.startswith("Unnamed")]
    # Drop rows that are entirely empty
    df = df.dropna(how="all")
    return df


def explore(df: pd.DataFrame) -> None:
    print("=" * 60)
    print("SHAPE:", df.shape)
    print("\nDATA TYPES:\n", df.dtypes)
    print("\nFIRST ROWS:\n", df.head())
    print("\nDESCRIPTIVE STATISTICS:\n", df.describe().T)
    print("\nCOUNT OF SENTINEL VALUE -200 PER COLUMN:\n", (df == -200).sum())
    print("\nDUPLICATE ROWS:", df.duplicated().sum())


# ---------------------------------------------------------------
# 3. TIMESTAMP PARSING AND DUPLICATES
# ---------------------------------------------------------------
def parse_datetime(df: pd.DataFrame) -> pd.DataFrame:
    # Time is stored as "18.00.00"; convert the dots to colons
    time_str = df["Time"].str.replace(".", ":", regex=False)
    df["Datetime"] = pd.to_datetime(
        df["Date"] + " " + time_str,
        format="%d/%m/%Y %H:%M:%S",
        errors="coerce",          # bad timestamps become NaT instead of crashing
    )
    print("Unparseable timestamps:", df["Datetime"].isna().sum())
    df = df.dropna(subset=["Datetime"]).drop(columns=["Date", "Time"])

    dupes = df["Datetime"].duplicated().sum()
    print("Duplicate timestamps:", dupes)
    df = (df.drop_duplicates(subset="Datetime")
            .sort_values("Datetime")
            .set_index("Datetime"))
    return df


# ---------------------------------------------------------------
# 4. MISSING VALUES
# ---------------------------------------------------------------
def handle_sentinels_and_missing(df: pd.DataFrame, drop_threshold: float = 50.0) -> pd.DataFrame:
    # -200 is the dataset's documented code for "sensor failed / no reading"
    df = df.replace(-200, np.nan)

    missing_pct = df.isna().mean().mul(100).round(2).sort_values(ascending=False)
    print("\nMISSING VALUES (%):\n", missing_pct)

    # Columns with too much missing data carry little information
    too_sparse = missing_pct[missing_pct > drop_threshold].index.tolist()
    if too_sparse:
        print(f"Dropping columns above {drop_threshold}% missing: {too_sparse}")
        df = df.drop(columns=too_sparse)
    return df


# ---------------------------------------------------------------
# 5. ERRONEOUS ENTRIES (domain rules)
# ---------------------------------------------------------------
DOMAIN_RULES = {
    "CO(GT)":   lambda s: s >= 0,
    "C6H6(GT)": lambda s: s >= 0,
    "NOx(GT)":  lambda s: s >= 0,
    "NO2(GT)":  lambda s: s >= 0,
    "RH":       lambda s: s.between(0, 100),    # relative humidity %
    "T":        lambda s: s.between(-50, 60),   # temperature in Celsius
}


def fix_invalid_entries(df: pd.DataFrame) -> pd.DataFrame:
    for col, rule in DOMAIN_RULES.items():
        if col not in df.columns:
            continue
        bad = df[col].notna() & ~rule(df[col])
        print(f"Invalid entries in {col}: {bad.sum()}")
        df.loc[bad, col] = np.nan     # mark as missing so it can be imputed
    return df


# ---------------------------------------------------------------
# 6. OUTLIERS (IQR method, winsorising)
# ---------------------------------------------------------------
def cap_outliers(df: pd.DataFrame, k: float = 3.0) -> pd.DataFrame:
    """
    Use k=3 (extreme outliers) instead of the usual 1.5 because
    pollution spikes can be real events. Capping (winsorising) keeps
    the row but limits its influence, which is safer than deleting it.
    """
    num_cols = df.select_dtypes("number").columns
    summary = {}
    for col in num_cols:
        s = df[col].dropna()
        q1, q3 = s.quantile([0.25, 0.75])
        iqr = q3 - q1
        lo, hi = q1 - k * iqr, q3 + k * iqr
        n_out = ((df[col] < lo) | (df[col] > hi)).sum()
        summary[col] = n_out
        df[col] = df[col].clip(lower=lo, upper=hi)
    print("\nOUTLIERS CAPPED PER COLUMN:\n", pd.Series(summary))
    return df


# ---------------------------------------------------------------
# 7. IMPUTATION (time-aware)
# ---------------------------------------------------------------
def impute(df: pd.DataFrame, max_gap_hours: int = 3) -> pd.DataFrame:
    num_cols = df.select_dtypes("number").columns

    # Keep a record of what was imputed. This is useful for later analysis.
    flags = df[num_cols].isna().add_suffix("_was_missing").astype(int)

    # Time-based interpolation. The limit prevents fabricating long gaps.
    df[num_cols] = df[num_cols].interpolate(
        method="time", limit=max_gap_hours, limit_direction="both"
    )
    df = pd.concat([df, flags], axis=1)

    remaining = df[num_cols].isna().any(axis=1).sum()
    print(f"\nRows still incomplete after limited interpolation: {remaining}")
    df = df.dropna(subset=num_cols)
    return df


# ---------------------------------------------------------------
# 8. VISUALISATIONS (screenshots for the report)
# ---------------------------------------------------------------
def plot_missingness(df: pd.DataFrame, path: str = "missingness_map.png") -> None:
    plt.figure(figsize=(10, 4))
    plt.imshow(df.isna().T, aspect="auto", cmap="Greys", interpolation="nearest")
    plt.yticks(range(df.shape[1]), df.columns)
    plt.xlabel("Row index (time order)")
    plt.title("Missing values (black = missing)")
    plt.tight_layout()
    plt.savefig(path, dpi=150)
    plt.close()


def plot_before_after(raw: pd.DataFrame, clean: pd.DataFrame,
                      col: str = "CO(GT)", path: str = "before_after.png") -> None:
    fig, ax = plt.subplots(1, 2, figsize=(10, 4))
    ax[0].boxplot(raw[col].dropna())
    ax[0].set_title(f"{col} - raw (includes -200 codes)")
    ax[1].boxplot(clean[col].dropna())
    ax[1].set_title(f"{col} - cleaned")
    plt.tight_layout()
    plt.savefig(path, dpi=150)
    plt.close()


# ---------------------------------------------------------------
# PIPELINE
# ---------------------------------------------------------------
def main():
    if not pd.io.common.file_exists(RAW) if hasattr(pd.io.common, "file_exists") else not __import__("os").path.exists(RAW):
        download_dataset()

    raw = load_raw()
    explore(raw)

    df = parse_datetime(raw.copy())
    raw_for_plot = df.copy()                 # snapshot before cleaning

    df = handle_sentinels_and_missing(df)
    df = fix_invalid_entries(df)
    df = cap_outliers(df)
    df = impute(df)

    print("\nFINAL SHAPE:", df.shape)
    print("Remaining missing values:", df.isna().sum().sum())

    df.to_csv(CLEAN)
    print(f"Cleaned dataset saved to {CLEAN}")

    plot_missingness(raw_for_plot)
    plot_before_after(raw_for_plot, df)
    print("Figures saved: missingness_map.png, before_after.png")


if __name__ == "__main__":
    main()
